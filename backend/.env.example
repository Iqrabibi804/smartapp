# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development

# Database

MONGO_URI=mongodb://127.0.0.1:27017/smartmap_ai
# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS
CLIENT_ORIGIN=http://localhost:3000

# Third-party APIs (Phase 4+, not used yet — add when implementing those phases)
GOOGLE_MAPS_API_KEY=
AI_PROVIDER_API_KEY=
WEATHER_API_KEY=
